node_modules/
build/
volume/
console/dist/
test-results/

# Per-machine Claude Code settings; the tracked settings.json is deliberate
.claude/settings.local.json

# Per-machine session costs, written by the SessionEnd hook. Regenerable from
# the transcripts at any time, and meaningless on another machine.
.claude/session-costs.tsv

# Per-machine gate discovery cache, written by Test-GatesCache.ps1. Regenerable
# by running /verify on any tree.
.claude/gates.json

# Scratch copies of issue bodies, written by /track while it compares the
# tracker against design/. Regenerable by re-running /track.
.track-ticks/
