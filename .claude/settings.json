{
  "hooks": {
    "SessionEnd": [
      {
        "type": "command",
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${CLAUDE_PROJECT_DIR}/tools/Measure-Session.ps1",
          "-Hook"
        ],
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "pwsh",
        "args": [
          "-NoProfile",
          "-File",
          "${CLAUDE_PROJECT_DIR}/tools/Measure-Session.ps1",
          "-Watch"
        ],
        "timeout": 30
      }
    ]
  }
}
