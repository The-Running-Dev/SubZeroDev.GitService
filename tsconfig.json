{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"],
  // S20's blog-parity scripts import a sibling repository checkout
  // (SubZeroDev.Blog) outside this tsconfig's module context; excluded from
  // the base's own typecheck gate for the same reason e2e/ gets its own
  // tsconfig rather than folding into this one -- they run standalone
  // (node --disable-warning=... scripts/generate-blog-tool-parity-fixtures.ts),
  // not through `npm run typecheck`.
  "exclude": ["scripts/generate-blog-tool-parity-fixtures.ts", "scripts/check-blog-tool-parity.ts"]
}
